<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="#f2f2f7">
  <title>Billing App</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <header class="app-header">
    <nav class="segmented-nav" id="tab-nav">
      <button class="segment-btn active" data-tab="new-bill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="12" y1="18" x2="12" y2="12"></line>
          <line x1="9" y1="15" x2="15" y2="15"></line>
        </svg>
        <span>New Bill</span>
      </button>
      <button class="segment-btn" data-tab="saved-bills">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <span>Saved Bills</span>
      </button>
      <button class="segment-btn" data-tab="products">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
          <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
          <line x1="12" y1="22.08" x2="12" y2="12"></line>
        </svg>
        <span>Products</span>
      </button>
    </nav>
  </header>

  <main class="app-main">
    <!-- New Bill Page -->
    <section id="page-new-bill" class="page active">
      <div class="invoice-header card">
        <span class="invoice-label">Invoice</span>
        <span class="invoice-number" id="invoice-number">INV-0001</span>
      </div>

      <div class="card">
        <div class="card-header">
          <h2 class="card-title">Customer Details</h2>
        </div>
        <div class="form-group">
          <label for="cust-name">Name</label>
          <input type="text" id="cust-name" class="input" placeholder="Customer name" autocomplete="off">
        </div>
        <div class="form-group">
          <label for="cust-mobile">Mobile</label>
          <input type="tel" id="cust-mobile" class="input" placeholder="Mobile number" autocomplete="off">
        </div>
        <div class="form-group">
          <label for="cust-address">Address</label>
          <textarea id="cust-address" class="input" placeholder="Address (Optional)" rows="2"></textarea>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h2 class="card-title">Items</h2>
          <span class="item-count" id="item-count">0 items</span>
        </div>
        <div id="items-list" class="items-list"></div>
        <button id="btn-add-item" class="btn btn-secondary btn-block">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          Add Item
        </button>
      </div>

      <div class="card totals-card">
        <div class="total-row">
          <span>Subtotal</span>
          <span id="subtotal">₹0.00</span>
        </div>
        <div class="total-row grand-total">
          <span>Grand Total</span>
          <span id="grand-total">₹0.00</span>
        </div>
      </div>

      <div class="card">
        <div class="form-group">
          <label for="bill-notes">Notes / Remarks</label>
          <textarea id="bill-notes" class="input" placeholder="Optional notes" rows="3"></textarea>
        </div>
      </div>
    </section>

    <!-- Saved Bills Page -->
    <section id="page-saved-bills" class="page">
      <div class="search-container">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="search-records" class="input search-input" placeholder="Search invoice, customer, mobile, item..." autocomplete="off">
        <button id="clear-search" class="clear-search-btn hidden" aria-label="Clear search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="search-meta">
        <span id="search-count">0 bills</span>
      </div>
      <div id="saved-records-list" class="records-list"></div>
    </section>

    <!-- Products Page -->
    <section id="page-products" class="page">
      <div id="products-list" class="products-list"></div>
      <button id="btn-add-product" class="btn btn-secondary btn-block">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Add Product
      </button>
    </section>
  </main>

  <!-- Bottom Action Bar -->
  <footer class="action-bar" id="action-bar">
    <button id="btn-save-bill" class="btn btn-primary">Save</button>
    <button id="btn-print-bill" class="btn btn-outline">Print</button>
    <button id="btn-thermal-58" class="btn btn-outline">58mm</button>
    <button id="btn-thermal-80" class="btn btn-outline">80mm</button>
  </footer>

  <!-- Autocomplete Dropdown -->
  <div id="autocomplete-dropdown" class="autocomplete-dropdown hidden"></div>

  <!-- Modals -->
  <div id="modal-overlay" class="modal-overlay hidden">
    <div class="modal" id="modal-content"></div>
  </div>

  <!-- Toast Container -->
  <div id="toast-container" class="toast-container"></div>

  <script src="app.js"></script>
</body>
</html>
